# RHEL_VERSION defined in Makefile
ARG RHEL_VERSION
FROM registry.access.redhat.com/${RHEL_VERSION}:latest

# CVE-2026-111943: upgrade ca-certificates and distrust the emSign roots.
# RHEL 9 has not shipped a fixed ca-certificates yet, so the roots are
# blocklisted locally. The build fails if any emSign root is still trusted.
RUN dnf -y update ca-certificates && \
    awk 'tolower($0) ~ /^# emsign/{p=1} p{print} /^-----END CERTIFICATE-----/{p=0}' \
        /etc/pki/ca-trust/extracted/pem/*.pem > /etc/pki/ca-trust/source/blocklist/cve-2026-111943-emsign.pem && \
    update-ca-trust extract && \
    if grep -qi '^# emsign' /etc/pki/ca-trust/extracted/pem/*.pem; then echo "emSign roots still trusted" >&2; exit 1; fi && \
    dnf clean all

COPY appstream.repo /etc/yum.repos.d/centos8-appstream.repo

COPY netperf.diff /tmp/netperf.diff
RUN dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-8.noarch.rpm && dnf clean all

RUN case "$(uname -m)" in \
        x86_64|aarch64|ppc64le) dnf install -y uperf perftest ;; \
        s390x) dnf install -y uperf ;; \
    esac && \
    dnf clean all

RUN dnf install -y --nodocs make automake --enablerepo=centos9 --allowerasing  && \
    dnf install -y --nodocs gcc git bc lksctp-tools-devel --enablerepo=*

RUN git clone https://github.com/HewlettPackard/netperf
WORKDIR netperf

RUN git reset --hard 3bc455b23f901dae377ca0a558e1e32aa56b31c4 && \
    git apply /tmp/netperf.diff && \
    ./autogen.sh && \
    ./configure --enable-sctp=yes --enable-demo=yes MAKEINFO=true && \
    make && make install

WORKDIR ../

RUN curl -L https://github.com/esnet/iperf/releases/download/3.16/iperf-3.16.tar.gz | tar xz && \
    cd iperf-3.16 && \
    ./configure; make install && \
    cd .. && \
    rm -rf iperf-3.16


RUN rm -rf netperf && \
    dnf clean all
RUN if grep -qi '^# emsign' /etc/pki/ca-trust/extracted/pem/*.pem; then echo "emSign roots still trusted" >&2; exit 1; fi
COPY super-netperf /usr/bin/super-netperf
